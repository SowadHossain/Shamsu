# Copy to .env to override defaults. Models and app state use persistent volumes.
SHAMSU_MODEL=qwen2.5-coder:3b-instruct
SHAMSU_CHAT_MAX_CTX=8192
SHAMSU_PORT=8765
SHAMSU_PROJECTS_DIR=./workspaces
# Optional stable credential. Leave empty to generate one in the state volume.
SHAMSU_WEB_AUTH_TOKEN=
# Pin a tested Ollama image tag or digest for your deployment.
OLLAMA_IMAGE=ollama/ollama:latest
